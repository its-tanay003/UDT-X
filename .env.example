# ==============================================================================
# UDT-X Environment Configuration Template
# Copy this file to .env and supply cryptographically strong random secrets.
# Do NOT commit production secrets to version control.
# ==============================================================================

# Cryptographic Keys (generate with: openssl rand -hex 32)
JWT_SECRET=<GENERATE_STRONG_RANDOM_SECRET_HEX_64_CHARS>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# TimescaleDB / PostgreSQL
POSTGRES_USER=udtx_user
POSTGRES_PASSWORD=<GENERATE_SECURE_POSTGRES_PASSWORD>
POSTGRES_DB=udtx
POSTGRES_PORT=5432

# Redpanda / Kafka
KAFKA_BROKER_PORT=9092
KAFKA_EXTERNAL_PORT=19092
REDPANDA_CONSOLE_PORT=8080

# Redis
REDIS_PORT=6379

# Neo4j
NEO4J_PASSWORD=<GENERATE_SECURE_NEO4J_PASSWORD>
NEO4J_AUTH=neo4j/<GENERATE_SECURE_NEO4J_PASSWORD>
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# FastAPI Application
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
