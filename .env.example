# ==============================================================================
# UDT-X Environment Configuration
# ==============================================================================

# TimescaleDB / PostgreSQL
POSTGRES_USER=udtx_user
POSTGRES_PASSWORD=udtx_password
POSTGRES_DB=udtx
POSTGRES_PORT=5432

# Redpanda / Kafka
KAFKA_BROKER_PORT=9092
KAFKA_EXTERNAL_PORT=19092
REDPANDA_CONSOLE_PORT=8080

# Redis
REDIS_PORT=6379

# Neo4j
NEO4J_AUTH=neo4j/udtxpassword
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# FastAPI Application
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
